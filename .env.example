# ---------------------------------------------------------------------------
# Supabase configuration
# Copy this file to `.env.local` and fill in your real values.
# Find these in your Supabase project: Settings -> API.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose this to the browser or commit a real value.
# Used for privileged server-side operations only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public site URL, used for Open Graph / canonical tags.
NEXT_PUBLIC_SITE_URL=https://framesbyfrady.com
